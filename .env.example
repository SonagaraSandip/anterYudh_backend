# ==========================================
# 🔀 DATABASE SWITCHER: 'dev' OR 'prod'
# ==========================================
DB_ENV=prod

# Database names
DB_NAME_DEV=defaultdb
DB_NAME_PROD=antarYudh_Prod

# Aiven Cloud MySQL Credentials
DB_HOST=mysql-xxxx.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_PORT=11585

# Server Port
PORT=5000

# ==========================================
# ☁️ GOOGLE DRIVE BACKUP CONFIGURATION
# ==========================================
# Google Drive Folder ID where backups should be saved
GOOGLE_DRIVE_BACKUP_FOLDER_ID=1alACIKa5btqwHzOT_WN4luKa9_2MPd9I

# Option A: Google Cloud Service Account (Google Workspace / Shared Drives)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# Option B: Google OAuth2 Refresh Token (Recommended for Personal @gmail.com accounts)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# Retention & Automation
BACKUP_RETENTION_DAYS=30
ENABLE_AUTO_BACKUP=true

